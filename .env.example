# Copie para .env e preencha. O .env está no .gitignore.
# Em produção (GitHub Actions), cadastre cada item em Settings > Secrets and variables > Actions.

# Stremio — opção A: authKey (localStorage do web.stremio.com, "profile" -> auth.key)
STREMIO_AUTH_KEY=
# Stremio — opção B (sem computador): e-mail e senha da conta; o authKey é gerado em runtime
STREMIO_EMAIL=
STREMIO_PASSWORD=

# TMDB — themoviedb.org > Settings > API > "API Read Access Token" (v4)
TMDB_READ_TOKEN=
# Conta TMDB onde você dá as notas (gerado por scripts/tmdb_login.py)
TMDB_ACCOUNT_ID=
TMDB_SESSION_ID=
# ...ou, sem aprovação no navegador: usuário e senha do TMDB (sessão criada a cada run)
TMDB_USERNAME=
TMDB_PASSWORD=

# Scorer: "auto" (Jev se houver chave, senão Haiku), "jev" ou "haiku"
SCORER=auto

# Anthropic — console.anthropic.com > API Keys (cobrança separada da assinatura claude.ai)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Jev — via Command Code (commandcode.ai > Studio > API keys) OU direto na TypeSafe
COMMAND_CODE_API_KEY=
TYPESAFE_API_KEY=

# Preferências
LANGUAGE=pt-BR
REGION=BR
CANDIDATES_PER_RUN=600
CATALOG_SIZE=100

# Notas da crítica nos pôsteres do Para Você — mdblist.com > Preferences > API
MDBLIST_API_KEY=
